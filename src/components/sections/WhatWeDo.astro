---
import { getEntry } from 'astro:content';
import { services } from '../../data/services';
import { WhatWeDoCards } from './WhatWeDoCards';

const { data } = await getEntry('landing', '03-what-we-do');
---
<section id="que-hacemos" class="gsap-section bg-background pb-12 pt-10 md:pb-20 md:pt-12" data-section="what-we-do">
  <div class="section-shell">
    <div class="border-b border-primary/20 pb-5 text-center">
      <h2 class="display-title text-6xl md:text-8xl">{data.headline}</h2>
      {data.subheadline && <p class="mt-4 text-[clamp(0.95rem,1.55vw,1.25rem)] leading-relaxed text-secondary">{data.subheadline}</p>}
    </div>
    <div class="mt-4 md:mt-5">
      <WhatWeDoCards services={services} client:visible />
    </div>
  </div>
</section>
