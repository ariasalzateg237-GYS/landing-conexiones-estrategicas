---
import { getEntry } from 'astro:content';
import { impactCards, impactHighlight } from '../../data/impact';

const { data } = await getEntry('landing', '06-impact');
const subheadlineLines = data.subheadline?.split('\n');
---
<section id="impacto" class="gsap-section overflow-hidden bg-primary py-14 text-background md:py-24" data-section="impact">
  <div class="section-shell">
    <div class="relative left-1/2 w-[calc(100vw-2rem)] max-w-[100rem] -translate-x-1/2 border-b border-background/20 pb-9 text-center md:w-[calc(100vw-5rem)]">
      <h2 class="display-title mx-auto max-w-[19ch] text-6xl text-background md:text-8xl lg:text-[6.75rem]">{data.headline}</h2>
      {subheadlineLines && (
        <p class="mx-auto mt-6 text-[clamp(0.95rem,1.55vw,1.25rem)] leading-relaxed text-background/70">
          {subheadlineLines.map((line) => <span class="block">{line}</span>)}
        </p>
      )}
    </div>

    <div class="mt-8 grid gap-px overflow-hidden rounded-xl bg-primary lg:grid-cols-[1.2fr_0.8fr]">
      <div class="impact-copy relative overflow-hidden rounded-xl bg-primary p-5 md:p-9">
        <p class="relative max-w-[20ch] font-heading text-[clamp(2.25rem,5.2vw,4.5rem)] font-semibold uppercase leading-[0.92] tracking-[-0.03em]">
          {impactHighlight.before}<span class="text-accent">{impactHighlight.accent1}</span>{impactHighlight.middle1}<span class="text-accent">{impactHighlight.accent2}</span>{impactHighlight.middle2}<span class="text-accent">{impactHighlight.accent3}</span>{impactHighlight.after}
        </p>
        <p class="relative mt-7 max-w-[52ch] text-base leading-relaxed text-primary-foreground md:text-lg">
          {impactHighlight.description}
        </p>
      </div>

      <div class="impact-visual relative min-h-[23rem] overflow-hidden rounded-xl bg-primary md:min-h-[32rem]">
        <img
          src="/images/impact/pet-clasificacion.webp"
          alt="Operario de G&S asegurando pacas de botellas PET recuperadas sobre un camión"
          width="1200"
          height="2133"
          loading="lazy"
          decoding="async"
          class="impact-image absolute inset-x-[0px] -top-[6%] h-[116%] w-full object-cover object-center"
        />
        <div aria-hidden="true" class="absolute inset-[0px] bg-[linear-gradient(to_top,rgba(0,0,0,.82),rgba(0,0,0,.06)_56%,rgba(0,0,0,.14))]"></div>
        <div class="absolute inset-x-5 bottom-5 flex items-end justify-between border-t border-background/20 pt-4 text-[9px] font-semibold uppercase tracking-[0.15em] text-background/50">
          <span>Material recuperado</span>
        </div>
      </div>
    </div>

    <div class="mt-12 grid gap-8 bg-primary md:mt-16 lg:grid-cols-3 lg:gap-6">
      {impactCards.map((card) => (
        <article class="impact-card relative flex flex-col items-center px-5 py-6 text-center md:px-7 md:py-10">
          <div class="whitespace-nowrap font-heading text-[clamp(2.5rem,3.8vw,3.5rem)] font-bold leading-none tracking-[-0.035em] text-background">{card.value}</div>
          <div class="mt-1 min-h-5 font-heading text-xl font-semibold uppercase leading-none text-accent">{card.unit}</div>
          <div class="mt-5 max-w-[25ch] text-base leading-relaxed text-background/70 md:text-lg">{card.label}</div>
        </article>
      ))}
    </div>

    <blockquote class="mx-auto mt-12 max-w-none text-center font-heading text-[clamp(1.75rem,3.3vw,3.25rem)] font-semibold uppercase leading-[0.92] tracking-[-0.03em] text-background md:mt-16 lg:whitespace-nowrap">
      <span aria-hidden="true" class="text-primary-foreground">“</span>Cada tonelada que vuelve al ciclo cuenta<span aria-hidden="true" class="text-primary-foreground">”</span>
    </blockquote>
  </div>
</section>
