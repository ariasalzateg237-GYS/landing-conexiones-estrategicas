---
import { getEntry } from 'astro:content';
import { milestones, historyPhotos } from '../../data/history';
import { HistoryCarousel } from './HistoryCarousel';
import { HistoryTimeline } from './HistoryTimeline';

const { data } = await getEntry('landing', '08-history');
const subheadlineLines = data.subheadline?.split('\n');
---
<section id="historia" class="gsap-section overflow-hidden bg-background py-14 md:py-24" data-section="history">
  <div class="section-shell">
    <div class="border-b border-primary/20 pb-8 text-center">
      <h2 class="display-title mx-auto max-w-[12ch] text-6xl md:text-8xl lg:max-w-none">{data.headline}</h2>
      {subheadlineLines && (
        <p class="mx-auto mt-6 text-[clamp(0.95rem,1.55vw,1.25rem)] leading-relaxed text-secondary">
          {subheadlineLines.map((line) => <span class="block">{line}</span>)}
        </p>
      )}
    </div>

    <div class="mt-10 grid gap-px bg-background lg:grid-cols-[0.9fr_1.1fr]">
      <div class="flex flex-col gap-px bg-background">
        <div class="history-visual relative isolate flex min-h-[36rem] flex-col overflow-hidden rounded-xl bg-background text-primary md:min-h-[40rem]">
          <HistoryCarousel photos={historyPhotos} client:visible />
        </div>
      </div>

      <div class="rounded-xl bg-background px-5 pb-5 md:px-8 md:pb-8">
        <HistoryTimeline milestones={milestones} client:visible />
      </div>
    </div>

  </div>
</section>
