<section
  class="fleet-reveal relative h-dvh bg-background"
  data-section="fleet-reveal"
  aria-label="Flota de transporte de carga"
>
  <div class="fleet-reveal-sticky relative h-full overflow-hidden bg-background">
    <!-- Art direction, no solo reescalado: el banner apaisado cubierto con
         object-cover en un viewport vertical deja ver apenas un cuarto de
         su ancho, asi que debajo de md entra una toma vertical de la misma
         flota. Va en <picture> y no en dos <img> con hidden/block porque
         display:none no evita la descarga: el navegador resuelve el media
         antes de pedir el archivo y baja uno solo. -->
    <picture>
      <source
        media="(max-width: 767px)"
        srcset="/images/fleet/flota-camiones-banner-vertical.webp"
        width="1200"
        height="2132"
      />
      <img
        src="/images/fleet/flota-camiones-banner.webp"
        alt="Flota de camiones de G&S Conexiones Estratégicas alineada junto a su equipo de conductores"
        width="2000"
        height="1125"
        loading="lazy"
        decoding="async"
        class="fleet-reveal-image absolute inset-[0px] h-full w-full scale-100 object-cover object-center will-change-transform"
      />
    </picture>
    <!-- Mismo velo simetrico del Hero: z-10 lo deja sobre la foto y debajo
         de la cortina (z-20), que se abre al llegar a mitad del viewport. -->
    <div
      aria-hidden="true"
      class="absolute inset-[0px] z-10 bg-[linear-gradient(to_bottom,rgba(0,0,0,.75)_0%,rgba(0,0,0,.42)_18%,rgba(0,0,0,.08)_38%,rgba(0,0,0,.08)_62%,rgba(0,0,0,.42)_82%,rgba(0,0,0,.75)_100%)]"
    ></div>
    <div aria-hidden="true" class="fleet-reveal-curtain absolute inset-y-[0px] -inset-x-px z-20 bg-background will-change-transform motion-reduce:hidden"></div>
  </div>
</section>
